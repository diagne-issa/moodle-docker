# PostgreSQL
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=replace_with_secure_postgres_password

# Moodle database connection
MOODLE_DB_TYPE=pgsql
MOODLE_DB_HOST=postgres
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=replace_with_secure_postgres_password

# Moodle site
MOODLE_WWWROOT=http://localhost:8080
MOODLE_INTERNAL_URL=http://moodle
MOODLE_DATA_ROOT=/var/www/moodledata
MOODLE_SITE_NAME="LMS Platform"

# Moodle admin account
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=replace_with_secure_admin_password
MOODLE_ADMIN_EMAIL=admin@example.com

# Moodle source code
MOODLE_BRANCH=MOODLE_501_STABLE